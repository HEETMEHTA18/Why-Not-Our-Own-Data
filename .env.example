# SuperCompress - query-aware prompt compression before local inference.
# Copy this file to `.env` and fill in your values. Do NOT commit `.env`.
#
#   enabled      - master switch (Tatvik /models/chat + Governor RAG)
#   api_key      - sc_live_* key for the hosted Compiler policy.
#                  Leave blank to use the bundled local policy (free, offline).
#   host         - hosted API base URL
#   min_tokens   - skip compression for contexts below this many words
#   timeout      - hosted request timeout in seconds
#
TATVIK_SUPERCOMPRESS_ENABLED=true
TATVIK_SUPERCOMPRESS_API_KEY=
TATVIK_SUPERCOMPRESS_HOST=https://www.supercompress.dev
TATVIK_SUPERCOMPRESS_MIN_TOKENS=100
TATVIK_SUPERCOMPRESS_TIMEOUT=10

# Training defaults (editable via the Settings page -> /system/settings PUT)
TATVIK_TRAINING_DEFAULT_MODEL=qwen2.5-coder-3b-instruct
TATVIK_TRAINING_DEFAULT_EPOCHS=3
TATVIK_TRAINING_DEFAULT_LR=0.0002
TATVIK_TRAINING_DEFAULT_LORA_R=16